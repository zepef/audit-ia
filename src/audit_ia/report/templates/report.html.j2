<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Audit de l'intégration de l'IA</title>
<style>
  :root { --fg: #1b1f24; --bg: #ffffff; --muted: #5b6470; --line: #d5dae0; --warn-bg: #fff4d6; --warn-fg: #7a4b00; --accent: #1f4e8c; }
  @media (prefers-color-scheme: dark) {
    :root { --fg: #e6e9ed; --bg: #14181d; --muted: #9aa4b0; --line: #2d343c; --warn-bg: #3a2e10; --warn-fg: #f3d58a; --accent: #8db8f2; }
  }
  body { font: 16px/1.55 system-ui, sans-serif; color: var(--fg); background: var(--bg); margin: 0 auto; max-width: 52rem; padding: 1rem 16px 3rem; }
  h1 { font-size: 1.7rem; margin-bottom: .2rem; }
  h2 { font-size: 1.3rem; margin-top: 2.2rem; border-bottom: 1px solid var(--line); padding-bottom: .2rem; }
  h3 { font-size: 1.05rem; margin-bottom: .3rem; }
  a { color: var(--accent); }
  ul { padding-left: 1.2rem; }
  li { margin: .5rem 0; }
  .meta, .refs, .src { color: var(--muted); font-size: .85rem; }
  .note { background: var(--warn-bg); color: var(--warn-fg); padding: .15rem .5rem; border-radius: 4px; font-size: .9rem; display: inline-block; margin-top: .2rem; }
  .stale { font-weight: 600; color: var(--warn-fg); background: var(--warn-bg); padding: 0 .3rem; border-radius: 3px; }
  .src { display: block; }
  footer { margin-top: 3rem; border-top: 1px solid var(--line); padding-top: .8rem; color: var(--muted); font-size: .85rem; }
</style>
</head>
<body>
{% macro source_line(s) %}
<span class="src">{{ s.publisher }}, <a href="{{ s.url }}">{{ s.title }}</a>. {% if s.verified_on %}Vérifié le {{ s.verified_on | date_fr }}{% else %}Date de vérification absente{% endif %}. Niveau de confiance : {{ s.confidence.value }}.{% if s.stale %} <span class="stale">À revérifier</span>{% endif %}</span>
{% endmacro %}
{% macro items(list) %}
<ul>
{% for item in list %}
  <li>{{ item.text }}
  {% if item.note %}<br><span class="note">{{ item.note }}</span>{% endif %}
  {% for s in item.sources %}{{ source_line(s) }}{% endfor %}
  {% if item.refs %}<span class="refs">Réf. : {% for r in item.refs %}{{ r.kind }} {{ r.id }}{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}
  </li>
{% endfor %}
</ul>
{% endmacro %}
<header>
  <h1>Audit de l'intégration de l'IA</h1>
  <p class="meta">Entreprise de {{ report.profile.headcount }} salariés, secteur {{ report.profile.sector }}, stade : {{ report.profile.stage.value }}. Répondant : {{ report.profile.respondent_role }}.</p>
</header>
<main>
<section id="synthese">
<h2>Synthèse</h2>
{{ items(report.summary) }}
</section>

<section id="dimensions">
<h2>Bilan par dimension</h2>
{% for d in dimensions %}
<h3>{{ dimension_labels[d] | capitalize }}</h3>
{{ items(report.by_dimension[d]) }}
{% endfor %}
{% if report.benchmarks %}
<h3>Autres repères</h3>
{{ items(report.benchmarks) }}
{% endif %}
</section>

<section id="cas-usage">
<h2>Cas d'usage prioritaires</h2>
{% if report.use_cases %}{{ items(report.use_cases) }}{% else %}<p>Aucun cas d'usage retenu à ce stade.</p>{% endif %}
</section>

<section id="obligations">
<h2>Obligations et échéances</h2>
<h3>Obligations applicables</h3>
{% if report.obligations %}{{ items(report.obligations) }}{% else %}<p>Aucune obligation applicable identifiée.</p>{% endif %}
<h3>Échéances à venir</h3>
{% if report.upcoming %}{{ items(report.upcoming) }}{% else %}<p>Aucune échéance à venir identifiée.</p>{% endif %}
<h3>À surveiller</h3>
{% if report.watch %}{{ items(report.watch) }}{% else %}<p>Rien à surveiller pour le moment.</p>{% endif %}
</section>

<section id="plan">
<h2>Plan d'action</h2>
{% for h in horizons %}
<h3>{{ horizon_labels[h] }}</h3>
{% if report.plan[h] %}{{ items(report.plan[h]) }}{% else %}<p>Aucune action sur cet horizon.</p>{% endif %}
{% endfor %}
</section>

<section id="verifications">
<h2>Vérifications à mener</h2>
{% if report.verifications %}{{ items(report.verifications) }}{% else %}<p>Aucune vérification en attente.</p>{% endif %}
</section>

<section id="aides">
<h2>Aides et dispositifs</h2>
{% if report.aids %}{{ items(report.aids) }}{% else %}<p>Aucune aide identifiée pour ce profil.</p>{% endif %}
</section>

<section id="non-mesure">
<h2>Ce qui n'est pas mesuré</h2>
{% if report.not_measured %}
<ul>{% for line in report.not_measured %}<li>{{ line }}</li>{% endfor %}</ul>
{% else %}<p>Tous les indicateurs suivis disposent d'un repère publié.</p>{% endif %}
</section>

<section id="sources">
<h2>Sources</h2>
{% if report.sources %}
<ul>{% for s in report.sources %}<li>{{ source_line(s) }}</li>{% endfor %}</ul>
{% else %}<p>Aucune source citée.</p>{% endif %}
</section>
</main>
<footer>Base de connaissances {{ report.kb_version }}. Rapport généré le {{ report.generated_on | date_fr }}.</footer>
</body>
</html>
